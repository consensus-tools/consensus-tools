{
  "name": "@consensus-tools/cli",
  "version": "0.8.0",
  "description": "CLI for consensus-tools — init, manage jobs, view traces",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "consensus-tools": "./bin/consensus.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@consensus-tools/core": "workspace:*",
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/storage": "workspace:*",
    "@consensus-tools/sdk-client": "workspace:*",
    "@consensus-tools/telemetry": "workspace:*",
    "commander": "^13.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/node": "^20.0.0",
    "openai": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src",
    "bin"
  ],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "consensus",
    "multi-agent",
    "ai-agents",
    "consensus-tools",
    "cli",
    "command-line"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/consensus-tools/consensus-tools/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
