{
  "name": "@consensus-tools/universal",
  "version": "0.11.0",
  "description": "Universal facade — wrap any tool executor with consensus governance in one line",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/storage": "workspace:*",
    "@consensus-tools/core": "workspace:*",
    "@consensus-tools/guards": "workspace:*",
    "@consensus-tools/personas": "workspace:*",
    "@consensus-tools/policies": "workspace:*"
  },
  "peerDependencies": {
    "@consensus-tools/langchain": "workspace:*",
    "@consensus-tools/ai-sdk": "workspace:*",
    "@consensus-tools/mcp": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@consensus-tools/langchain": { "optional": true },
    "@consensus-tools/ai-sdk": { "optional": true },
    "@consensus-tools/mcp": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src"
  ],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/toolkit.git",
    "directory": "packages/universal"
  },
  "keywords": [
    "consensus",
    "multi-agent",
    "ai-agents",
    "consensus-tools",
    "facade",
    "universal",
    "governance"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/consensus-tools/toolkit/tree/main/packages/universal",
  "bugs": {
    "url": "https://github.com/consensus-tools/toolkit/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
