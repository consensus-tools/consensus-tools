{
  "name": "@consensus-tools/workflows",
  "version": "0.5.0",
  "description": "Workflow execution engine and cron scheduler for consensus-tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/core": "workspace:*",
    "@consensus-tools/guards": "workspace:*",
    "@consensus-tools/evals": "workspace:*",
    "@consensus-tools/integrations": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src"
  ],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git",
    "directory": "packages/workflows"
  },
  "keywords": [
    "consensus",
    "multi-agent",
    "ai-agents",
    "consensus-tools",
    "dag",
    "hitl",
    "cron",
    "workflow-engine"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/consensus-tools/consensus-tools/tree/main/packages/workflows",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
