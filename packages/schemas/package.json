{
  "name": "@consensus-tools/schemas",
  "version": "0.3.0",
  "description": "Shared types and Zod schemas for consensus-tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "files": ["dist", "src"],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git",
    "directory": "packages/schemas"
  },
  "homepage": "https://github.com/consensus-tools/consensus-tools/tree/main/packages/schemas",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
