{
  "name": "@consensus-tools/wrapper",
  "version": "0.3.0",
  "description": "Runtime decision firewall — wraps any function with consensus gates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "node --import tsx/esm --test src/__tests__/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/core": "workspace:*",
    "@consensus-tools/policies": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "files": ["dist", "src"],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git",
    "directory": "packages/wrapper"
  },
  "homepage": "https://github.com/consensus-tools/consensus-tools/tree/main/packages/wrapper",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
