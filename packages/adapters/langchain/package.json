{
  "name": "@consensus-tools/langchain",
  "version": "0.8.0",
  "description": "LangChain adapter — consensus-tools guards as LangChain tools + decision callback handler",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/guards": "workspace:*",
    "zod": "^3.23.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "langsmith": ">=0.4.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.34",
    "langsmith": "^0.5.11",
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
