{
  "name": "@consensus-tools/openclaw",
  "version": "0.4.0",
  "description": "OpenClaw plugin adapter for consensus-tools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@consensus-tools/schemas": "workspace:*",
    "@consensus-tools/core": "workspace:*",
    "@consensus-tools/policies": "workspace:*",
    "@consensus-tools/sdk-client": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "src",
    "openclaw.plugin.json"
  ],
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git",
    "directory": "packages/adapters/openclaw"
  },
  "keywords": [
    "consensus",
    "multi-agent",
    "ai-agents",
    "consensus-tools",
    "openclaw",
    "plugin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/consensus-tools/consensus-tools/tree/main/packages/adapters/openclaw",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
