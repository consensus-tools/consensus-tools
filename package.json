{
  "name": "consensus-tools",
  "private": true,
  "description": "Decision infrastructure for agentic systems — monorepo",
  "author": "consensus-tools <https://github.com/consensus-tools>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/consensus-tools/consensus-tools.git"
  },
  "homepage": "https://github.com/consensus-tools/consensus-tools",
  "bugs": {
    "url": "https://github.com/consensus-tools/consensus-tools/issues"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules",
    "typecheck": "turbo typecheck",
    "dep-check": "depcruise --config .dependency-cruiser.cjs packages apps",
    "dep-graph": "depcruise --config .dependency-cruiser.cjs --output-type dot packages | dot -T svg > docs/dependency-graph.svg",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "dependency-cruiser": "^16.0.0",
    "tsx": "^4.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
